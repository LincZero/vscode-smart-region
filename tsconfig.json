{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "outDir": "out",
        "lib": [
            "ES2022"
        ],
        "types": [
            "node",
            "mocha",
        ],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true, /* 启用所有严格的类型检查选项 */
        /* 额外检查 */
        // "noImplicitReturns": true, /* 当函数中所有代码路径均未返回值时报告错误 */
        // "noFallthroughCasesInSwitch": true, /* 报告 switch 语句中跳转情况的错误 */
        // "noUnusedParameters": true,  /* 报告未使用的参数错误 */
    }
}
