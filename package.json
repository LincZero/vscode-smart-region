{
  "name": "smart-region",
  "displayName": "Smart Region",
  "description": "Smartly create regions",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smart-region.toggle",
        "title": "Smart Region: 开启/关闭插件功能",
        "category": "Smart Region"
      },
      {
        "command": "smart-region.toggleHighlight",
        "title": "Smart Region: 开启/关闭高亮",
        "category": "Smart Region"
      }
    ],
    "configuration": {
      "title": "Smart Region",
      "properties": {
        "smartRegion.enableIndentEnd": {
          "type": "boolean",
          "default": true,
          "description": "缩进敏感：遇到更小缩进的行会结束 region (若关闭，所有分割线都视为顶格)"
        },
        "smartRegion.enableHighlight": {
          "type": "boolean",
          "default": true,
          "description": "为 region 区域添加背景色高亮 (类似 highlight-region 插件)"
        },
        "smartRegion.highlightColor": {
          "type": "string",
          "default": "rgba(100, 150, 255, 0.08)",
          "description": "region 区域背景色，支持任意 CSS 颜色 (如 rgba(...)、#RRGGBB、theme token)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
